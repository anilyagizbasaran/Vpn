# Build context for website/Dockerfile is the repository root, so the same
# exclusions the server context needs apply here — plus the parts of the
# workspace the dashboard build has no use for.
.git
**/node_modules
**/.dart_tool
**/build
server/data
**/.env
**/.env.*
*.db
*.db-wal
*.db-shm
vpnd/bin
*.exe
