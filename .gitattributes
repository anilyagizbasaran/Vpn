# Normalise everything to LF in the repository.
#
# Without this, Git on Windows checks files out with CRLF and the shell
# scripts break on the VPS with "bad interpreter: /usr/bin/env bash^M".
* text=auto eol=lf

# Files that must be LF no matter what, because something other than a text
# editor reads them.
*.sh        text eol=lf
Caddyfile   text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
Dockerfile  text eol=lf

# Windows-only tooling that genuinely wants CRLF.
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Never touched.
*.png       binary
*.jpg       binary
*.ico       binary
*.jar       binary
*.keystore  binary
