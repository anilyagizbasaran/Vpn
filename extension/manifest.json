{
  "manifest_version": 3,
  "name": "VPN Client",
  "version": "0.3.0",
  "description": "Shows your VPN status, turns the tunnel on or off, and closes the leaks a tunnel cannot close by itself.",
  "minimum_chrome_version": "116",

  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms",
    "privacy",
    "declarativeNetRequest",
    "activeTab"
  ],

  "declarative_net_request": {
    "rule_resources": [
      { "id": "ads", "enabled": true, "path": "rules/ads.json" },
      { "id": "trackers", "enabled": true, "path": "rules/trackers.json" }
    ]
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "VPN Client",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },

  "commands": {
    "toggle-tunnel": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Connect or disconnect the VPN"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  }
}
