{
  "manifest_version": 3,
  "name": "VPN Client",
  "version": "0.1.0",
  "description": "Shows your VPN status and turns the tunnel on or off. Requires the VPN desktop app.",
  "minimum_chrome_version": "116",

  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "VPN Client",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  }
}
