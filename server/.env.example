# ---------------------------------------------------------------------------
# Control plane
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Number of reverse proxies in front of the API. 0 = exposed directly.
# Behind Caddy/nginx this MUST be 1, otherwise every request buckets as
# 127.0.0.1 and one user's traffic rate-limits everyone else.
# Never set it higher than the real number of proxies: each extra hop lets a
# client forge X-Forwarded-For and choose its own rate-limit bucket.
TRUST_PROXY=0
# Comma-separated allowed browser origins. Mobile apps do not send Origin,
# so this only matters if you later add a web dashboard. Empty = no CORS.
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_PATH=./data/vpn.db

# ---------------------------------------------------------------------------
# Auth — generate with `npm run keygen`
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=CHANGE_ME_generate_with_npm_run_keygen
JWT_ACCESS_TTL=15m
# Refresh tokens are opaque random strings, stored only as HMAC(pepper, token).
JWT_REFRESH_PEPPER=CHANGE_ME_generate_with_npm_run_keygen
REFRESH_TTL_DAYS=30
JWT_ISSUER=vpn-control-plane
# How long a revoked refresh token is kept so a replay still trips reuse
# detection instead of looking like an unknown token.
REFRESH_REVOKED_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# Peer / device policy
# ---------------------------------------------------------------------------
MAX_DEVICES_PER_USER=5
# Optional WireGuard preshared key per peer (extra symmetric layer).
# When true, PSKs are stored encrypted at rest with PSK_ENCRYPTION_KEY.
WG_ENABLE_PRESHARED_KEY=false
# 32 bytes hex (64 chars). Required only when WG_ENABLE_PRESHARED_KEY=true.
PSK_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# WireGuard server — values printed by scripts/setup-wg.sh
# ---------------------------------------------------------------------------
WG_INTERFACE=wg0
WG_SERVER_PUBLIC_KEY=
WG_ENDPOINT=vpn.example.com:51820
WG_LISTEN_PORT=51820
WG_ADDRESS_POOL=10.8.0.0/24
WG_SERVER_ADDRESS=10.8.0.1
WG_DNS=1.1.1.1, 1.0.0.1
WG_REGION=de-fra
# What the client routes through the tunnel. 0.0.0.0/0,::/0 = full tunnel.
WG_CLIENT_ALLOWED_IPS=0.0.0.0/0,::/0
WG_PERSISTENT_KEEPALIVE=25
# Client-side MTU. Match the server interface (setup-wg.sh writes 1420).
# 0 omits the line and lets the platform guess, which can silently blackhole
# large packets on some mobile networks. Lower to 1380 if users report that
# HTTPS stalls while ping works.
WG_CLIENT_MTU=1420


# How often node agents sync. Also the worst-case delay before a revoked
# device stops working, because the control plane never pushes.
NODE_POLL_SECONDS=10

# Define one node from this file. Additional nodes: npm run node:add
WG_SKIP_BOOTSTRAP_NODE=false
WG_DISPLAY_NAME=Frankfurt
