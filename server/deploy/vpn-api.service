# /etc/systemd/system/vpn-api.service
#
#   sudo cp deploy/vpn-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now vpn-api
#
[Unit]
Description=WireGuard VPN control plane
Documentation=https://github.com/anilyagizbasaran/Vpn
After=network-online.target
Wants=network-online.target
# Deliberately no dependency on wg-quick: the control plane never opens the
# interface, so it must stay up when WireGuard is down. It can run on a host
# with no WireGuard installed at all.

[Service]
Type=simple
User=wgapi
Group=wgapi
WorkingDirectory=/opt/vpn-control-plane
EnvironmentFile=/opt/vpn-control-plane/.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=3

# --- privileges -------------------------------------------------------------
# None. This service issues no commands and opens no sockets but its own
# listener: peers reach the interface through the node agent, which holds
# CAP_NET_ADMIN so that nothing else has to. An empty bounding set means the
# process cannot acquire a capability even if something tries.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
PrivateDevices=true
RestrictSUIDSGID=true
# Only what an HTTP server needs; blocks AF_NETLINK, which is how `wg` talks
# to the kernel. If this service ever tries to configure WireGuard again, it
# fails here rather than succeeding quietly.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# --- sandboxing -------------------------------------------------------------
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
# The SQLite database is the only thing the service writes.
ReadWritePaths=/opt/vpn-control-plane/data

LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
