# /etc/systemd/system/vpn-api.service
#
#   sudo cp deploy/vpn-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now vpn-api
#
[Unit]
Description=WireGuard VPN control plane
Documentation=https://github.com/your-org/vpn
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
# The API re-applies peers onto the interface at boot, so the interface has
# to exist first.
Requires=wg-quick@wg0.service

[Service]
Type=simple
User=wgapi
Group=wgapi
WorkingDirectory=/opt/vpn-control-plane
EnvironmentFile=/opt/vpn-control-plane/.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=3

# --- privileges -------------------------------------------------------------
# CAP_NET_ADMIN is all `wg` needs to read and modify the interface, and ambient
# capabilities are inherited across exec, so the `wg` child gets it too. This
# is why the service can keep NoNewPrivileges and still manage peers.
# Requires WG_SUDO=false in .env.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
#
# Fallback if capabilities are unavailable (containers, odd kernels): comment
# out the three lines above, set NoNewPrivileges=no, and set WG_SUDO=true —
# setup-wg.sh already installed /etc/sudoers.d/wgapi limiting the user to the
# `wg` binary. NoNewPrivileges=yes and sudo are mutually exclusive.

# --- sandboxing -------------------------------------------------------------
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
# The SQLite database is the only thing the service writes.
ReadWritePaths=/opt/vpn-control-plane/data

LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
