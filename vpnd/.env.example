# Copy to vpnd/.env — that name is gitignored, this one is not.
#
# Only needed when running the agent from docker-compose
# (`docker compose --profile agent up -d`). The systemd unit reads the same
# variables from /etc/vpn-node-agent.env instead.

# The agent runs with host networking, so it cannot reach the API over the
# compose network. Use the public HTTPS URL: the token travels with every
# request and must not cross the wire in the clear.
VPN_CONTROL_PLANE=https://api.example.com

# Printed exactly once by `docker compose exec api node scripts/add-node.mjs`.
# If it is lost, register the node again — it cannot be read back.
VPN_NODE_TOKEN=

# The interface wg-quick brought up on the host. The agent only edits its peer
# table; it never creates or destroys it.
VPN_INTERFACE=wg0
