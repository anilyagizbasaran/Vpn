# /etc/systemd/system/vpnd.service
#
#   sudo install -m 755 vpnd /usr/local/bin/vpnd
#   sudo groupadd -f vpn && sudo usermod -aG vpn "$USER"
#   sudo cp deploy/vpnd.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now vpnd
#
# Log out and back in for the group change to take effect, or the desktop app
# will not be able to open the socket.
[Unit]
Description=VPN client tunnel service
Documentation=https://github.com/anilyagizbasaran/Vpn
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
#
# Add --kill-switch to block traffic that is not going through the tunnel.
# Off by default because it is the one setting that can leave a machine with no
# network: it needs nftables, and a rule that fails to come off strands whoever
# is at the keyboard. `sudo nft delete table inet vpnkill` undoes it by hand,
# and vpnd clears any leftover block every time it starts.
#
# Windows does not use this. wireguard.exe already installs WFP filters that
# drop untunneled traffic for the configs this daemon accepts.
ExecStart=/usr/local/bin/vpnd --interface vpn0
Restart=on-failure
RestartSec=3

# --- privileges -------------------------------------------------------------
# Runs as root because wg-quick needs to create an interface and write routes.
# CAP_NET_ADMIN alone is not enough: wg-quick also calls `ip` and `resolvconf`.
# The compensating control is that the daemon accepts only a validated tunnel
# config over its socket — see internal/tunnel/config.go — so reaching it does
# not give you the ability to run commands.
User=root
Group=root

# The socket lives here, group-owned by `vpn` so desktop users in that group
# can drive the tunnel and nobody else can.
RuntimeDirectory=vpnd
RuntimeDirectoryMode=0750

# --- sandboxing -------------------------------------------------------------
# Deliberately mild. Hardening that blocks netlink, module loading or /dev/net
# breaks the tunnel itself, and a service that is "hardened" into not working
# gets disabled by the first user who hits it.
NoNewPrivileges=no
ProtectHome=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
# wg-quick reads and writes the tunnel config here.
ReadWritePaths=/etc/wireguard

[Install]
WantedBy=multi-user.target
